# Local development only.\n# The local PGlite socket server is single-protocol-state and rejects\n# concurrent extended-protocol messages from multiple sockets. Keep the\n# app pool and socket server both pinned to one connection.\nDATABASE_URL=postgres://pizzacut:pizzacut@127.0.0.1:5432/pizzacut\nPG_MAX_CONNECTIONS=1\nLOCAL_DB_MAX_CONNECTIONS=1\n# Server token used for session cookies.\nAUTH_SECRET=dev-secret-change-me\n# Public-facing origin used for auth callbacks (dev server).\nAPP_ORIGIN=http://localhost:3000\n